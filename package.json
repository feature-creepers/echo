{
  "name": "jarvis",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "contributors": [
    "Tommy Sendra",
    "Rodolphe Barbanneau"
  ],
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 160,
    "endOfLine": "lf"
  }
}
