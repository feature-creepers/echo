{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Code that runs anywhere: Node, a browser. No Node types and no DOM,
    // so using either is a compile error.
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": [],

    // Sources are imported as they are written (.ts), with no build step between packages.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Each package is a project of its own: `tsc --build` checks them in dependency order.
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true
  }
}
