{
  // Everything that runs anywhere. The transport to a local core needs Node and is its own project: tsconfig.node.json.
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/anywhere"
  },
  "include": ["src"],
  "exclude": ["src/transports/local.ts", "src/transports/local.test.ts"],
  "references": [{ "path": "../protocol" }]
}
